{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/_build/(.*)",
      "dest": "/_build/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
